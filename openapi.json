  "components": {
    "schemas": {
      "CreateEmployeeDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "João Silva",
            "description": "Nome completo do funcionário"
          },
          "email": {
            "type": "string",
            "example": "joao@empresa.com",
            "description": "E-mail corporativo único"
          },
          "role": {
            "type": "string",
            "enum": [
              "INTERN",
              "ENGINEER",
              "ADMIN"
            ],
            "example": "ENGINEER",
            "description": "Cargo do funcionário dentro da empresa"
          }
        },
        "required": [
          "name",
          "email",
          "role"
        ]
      },
      "UpdateEmployeeDto": {
        "type": "object",
        "properties": {}
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "usuario@email.com",
            "description": "O e-mail único do usuário para login"
          },
          "password": {
            "type": "string",
            "example": "Senha@123",
            "description": "Senha de acesso (mínimo 8 caracteres)"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "usuario@email.com",
            "description": "O e-mail único do usuário para login"
          },
          "password": {
            "type": "string",
            "example": "Senha@123",
            "description": "Senha de acesso (mínimo 8 caracteres)"
          }
        }
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "cgr@gmail.com",
            "description": "E-mail do usuário para login"
          },
          "password": {
            "type": "string",
            "example": "Senha@123",
            "description": "Senha de acesso (mínimo 8 caracteres)"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "SignupDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "cgr@gmail.com",
            "description": "E-mail para criação da conta"
          },
          "password": {
            "type": "string",
            "example": "Senha@123",
            "description": "Senha de acesso (mínimo 8 caracteres)"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "joao@empresa.com",
            "description": "E-mail do usuário para recuperação de senha"
          }
        },
        "required": [
          "email"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "example": "a1b2c3d4-e5f6-g7h8-i9j0",
            "description": "Token de recuperação enviado por e-mail"
          },
          "newPassword": {
            "type": "string",
            "example": "NovaSenha@2026",
            "description": "A nova senha que o usuário deseja definir"
          }
        },
        "required": [
          "token",
          "newPassword"
        ]
      }
    }
  }
