  "info": {
    "title": "Users API",
    "description": "API for managing users",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "users",
      "description": ""
    }
  ],
  "servers": [],
  "components": {
    "schemas": {
      "CreateEmployeeDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "João Silva",
            "description": "Nome completo do funcionário"
          },
          "email": {
            "type": "string",
            "example": "joao@empresa.com",
            "description": "E-mail corporativo único"
          },
          "role": {
            "type": "string",
            "enum": [
              "INTERN",
              "ENGINEER",
              "ADMIN"
            ],
            "example": "ENGINEER",
            "description": "Cargo do funcionário dentro da empresa"
          }
        },
        "required": [
          "name",
          "email",
          "role"
        ]
      },
      "EmployeeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1,
            "description": "id do funcionario",
            "title": "ID"
          },
          "name": {
            "type": "string",
            "example": "João Silva",
            "description": "nome do funcionario",
            "title": "Nome"
          },
          "email": {
            "type": "string",
            "example": "joao@empresa.com",
            "description": "email do funcionario",
            "title": "Email"
          },
          "role": {
            "type": "string",
            "enum": [
              "INTERN",
              "ENGINEER",
              "ADMIN"
            ],
            "description": "cargo do funcionario",
            "title": "Cargo"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "role"
        ]
      },
      "ErrorResonseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 400,
            "description": "error response status code"
          },
          "message": {
            "type": "string",
            "example": "Bad Request",
            "description": "error response message"
          },
          "success": {
            "type": "boolean",
            "example": false,
            "description": "error response success status"
          },
          "path": {
            "type": "string",
            "example": "/api/auth/login"
          },
          "timestamp": {
            "type": "string",
            "example": "2026-01-01T00:00:00.000Z"
          }
        },
        "required": [
          "statusCode",
          "message",
          "success",
          "path",
          "timestamp"
        ]
      },
      "UpdateEmployeeDto": {
        "type": "object",
        "properties": {}
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "usuario@email.com",
            "description": "O e-mail único do usuário para login"
          },
          "password": {
            "type": "string",
            "example": "Senha@123",
            "description": "Senha de acesso (mínimo 8 caracteres)"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "usuario@email.com",
            "description": "O e-mail único do usuário para login"
          },
          "password": {
            "type": "string",
            "example": "Senha@123",
            "description": "Senha de acesso (mínimo 8 caracteres)"
          }
        }
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "cgr@gmail.com",
            "description": "E-mail do usuário para login"
          },
          "password": {
            "type": "string",
            "example": "Senha@123",
            "description": "Senha de acesso (mínimo 8 caracteres)"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AtuhResponseDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "example": "qieinasjaksc",
            "description": "access token",
            "title": "Acess token"
          },
          "statusCode": {
            "type": "number",
            "example": 200,
            "description": "status code",
            "title": "Status code"
          },
          "success": {
            "type": "boolean",
            "example": true,
            "description": "indicates if the operation was successful",
            "title": "Success"
          },
          "message": {
            "type": "string",
            "example": "qieinasjaksc",
            "description": "message of response to be sent to the client",
            "title": "Message"
          },
          "verified": {
            "type": "boolean",
            "example": false,
            "description": "indicates if the user is verified",
            "title": "Verified"
          },
          "cookie": {
            "type": "string",
            "example": "qieinasjaksc",
            "description": "cookie string to be set in the response header",
            "title": "Cookie"
          }
        },
        "required": [
          "statusCode",
          "success",
          "message"
        ]
      },
      "SignupDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "cgr@gmail.com",
            "description": "E-mail para criação da conta"
          },
          "password": {
            "type": "string",
            "example": "Senha@123",
            "description": "Senha de acesso (mínimo 8 caracteres)"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "joao@empresa.com",
            "description": "E-mail do usuário para recuperação de senha"
          }
        },
        "required": [
          "email"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "example": "a1b2c3d4-e5f6-g7h8-i9j0",
            "description": "Token de recuperação enviado por e-mail"
          },
          "newPassword": {
            "type": "string",
            "example": "NovaSenha@2026",
            "description": "A nova senha que o usuário deseja definir"
          }
        },
        "required": [
          "token",
          "newPassword"
        ]
      }
    }
  }
}